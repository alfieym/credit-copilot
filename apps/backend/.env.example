# ===== LLM 提供商（欧美主流：默认 OpenAI；国内可切 DeepSeek/通义/智谱；Claude 走 Bedrock）=====
# LLM_PROVIDER=openai | deepseek | qwen | zhipu | bedrock
LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- OpenAI 兼容端点（LLM_PROVIDER=deepseek/qwen/zhipu 时生效） ---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_REASONER_MODEL=deepseek-reasoner

# --- Claude via AWS Bedrock（LLM_PROVIDER=bedrock 时生效，需 boto3：uv sync --extra bedrock） ---
AWS_REGION=us-east-1
BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# ===== Embedding（OpenAI 兼容：SiliconFlow BGE-M3；也可用本地 FlagEmbedding）=====
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ===== Postgres + pgvector =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=credit_copilot
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit

# ===== Langfuse（可观测，阶段4启用）=====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
