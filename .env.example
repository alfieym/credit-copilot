# ===== LLM（OpenAI 兼容：DeepSeek / 通义 / 智谱 均可，改 BASE_URL + MODEL 即可切换）=====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_REASONER_MODEL=deepseek-reasoner

# ===== Embedding（OpenAI 兼容：SiliconFlow BGE-M3；也可用本地 FlagEmbedding）=====
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ===== Postgres + pgvector =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=credit_copilot
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit

# ===== Langfuse（可观测，阶段4启用）=====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
